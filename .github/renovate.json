{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "extends": ["github>aquaproj/aqua-renovate-config#2.14.0", "group:allNonMajor"],
  "minimumReleaseAge": "7 days",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub CLI extensions pinned to release tags.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^README\\.md$/"],
      "matchStrings": [
        "gh extension install (?<depName>[\\w.-]+/gh-[\\w.-]+) --pin (?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge patch and minor updates after required checks pass.",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "labels": ["renovate-automerge"]
    },
    {
      "description": "Require human review for major updates.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 5
}
